# Copy to .env and fill in locally. Never commit .env.

# Garmin login is only needed when ~/.garminconnect has no valid token.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMINTOKENS=~/.garminconnect

# OpenAI Secure MCP Tunnel runtime key. Keep this secret.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=tunnel_6aa407da2e048191a432d614307fe6ec

# Local MCP server settings.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_TRANSPORT=streamable-http
